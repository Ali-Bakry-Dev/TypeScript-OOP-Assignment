<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-11-15T19:20:00.000Z" agent="ChatGPT" version="24.7.17" type="device">
  <diagram id="assignment14-uml-clean" name="Assignment 14 - UML Class Diagram">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="heading" value="SIMPLE NOTES MANAGEMENT SYSTEM" style="text;html=1;align=center;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#17324D;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="250" y="18" width="1100" height="42" as="geometry"/></mxCell>
        <mxCell id="subheading" value="UML CLASS DIAGRAM — ASSIGNMENT 14" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#526579;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="250" y="60" width="1100" height="30" as="geometry"/></mxCell>

        <mxCell id="admin" value="&lt;div style='font-size:20px;font-weight:bold;text-align:center;padding:7px'&gt;Admin&lt;/div&gt;&lt;hr/&gt;&lt;div style='font-size:15px;text-align:left;padding:10px'&gt;&lt;i&gt;Inherits all attributes from User&lt;/i&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style='font-size:15px;text-align:left;padding:10px'&gt;+ manageNotes(): void&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2EAF8;strokeColor=#8055A5;strokeWidth=2;align=center;verticalAlign=top;spacing=5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="70" y="180" width="330" height="150" as="geometry"/></mxCell>

        <mxCell id="user" value="&lt;div style='font-size:20px;font-weight:bold;text-align:center;padding:7px'&gt;User&lt;/div&gt;&lt;hr/&gt;&lt;div style='font-size:15px;text-align:left;line-height:1.55;padding:10px'&gt;+ id: number&lt;br/&gt;# name: string&lt;br/&gt;- email: string&lt;br/&gt;- password: string&lt;br/&gt;- phone: string&lt;br/&gt;- age: number&lt;br/&gt;- notebooks: NoteBook[]&lt;/div&gt;&lt;hr/&gt;&lt;div style='font-size:15px;text-align:left;line-height:1.55;padding:10px'&gt;+ displayInfo(): void&lt;br/&gt;+ addNotebook(notebook: NoteBook): void&lt;br/&gt;+ getNotebooks(): NoteBook[]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF2F8;strokeColor=#35658A;strokeWidth=2;align=center;verticalAlign=top;spacing=5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="590" y="135" width="430" height="365" as="geometry"/></mxCell>

        <mxCell id="storage" value="&lt;div style='font-size:20px;font-weight:bold;text-align:center;padding:7px'&gt;Storage&lt;T&gt;&lt;/div&gt;&lt;hr/&gt;&lt;div style='font-size:15px;text-align:left;padding:10px'&gt;- items: T[]&lt;/div&gt;&lt;hr/&gt;&lt;div style='font-size:15px;text-align:left;line-height:1.55;padding:10px'&gt;+ addItem(item: T): void&lt;br/&gt;+ removeItem(item: T): void&lt;br/&gt;+ getAllItems(): T[]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF4DF;strokeColor=#B47B20;strokeWidth=2;align=center;verticalAlign=top;spacing=5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1190" y="180" width="340" height="210" as="geometry"/></mxCell>

        <mxCell id="notebook" value="&lt;div style='font-size:20px;font-weight:bold;text-align:center;padding:7px'&gt;NoteBook&lt;/div&gt;&lt;hr/&gt;&lt;div style='font-size:15px;text-align:left;padding:10px'&gt;- notes: Note[]&lt;/div&gt;&lt;hr/&gt;&lt;div style='font-size:15px;text-align:left;line-height:1.55;padding:10px'&gt;+ addNote(note: Note): void&lt;br/&gt;+ removeNote(noteId: number): void&lt;br/&gt;+ getNotes(): Note[]&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#4C8550;strokeWidth=2;align=center;verticalAlign=top;spacing=5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="330" y="650" width="400" height="220" as="geometry"/></mxCell>

        <mxCell id="note" value="&lt;div style='font-size:20px;font-weight:bold;text-align:center;padding:7px'&gt;Note&lt;/div&gt;&lt;hr/&gt;&lt;div style='font-size:15px;text-align:left;line-height:1.55;padding:10px'&gt;+ id: number&lt;br/&gt;+ title: string&lt;br/&gt;+ content: string&lt;br/&gt;+ userId: User&lt;/div&gt;&lt;hr/&gt;&lt;div style='font-size:15px;text-align:left;padding:10px'&gt;+ preview(): string&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EAF5EA;strokeColor=#4C8550;strokeWidth=2;align=center;verticalAlign=top;spacing=5;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1000" y="650" width="400" height="220" as="geometry"/></mxCell>

        <mxCell id="inheritance" value="Inheritance" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeWidth=2;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=0;strokeColor=#8055A5;" edge="1" parent="1" source="admin" target="user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="255"/><mxPoint x="520" y="255"/></Array></mxGeometry></mxCell>

        <mxCell id="aggregation" value="Aggregation" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeWidth=2;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;startArrow=diamond;startFill=0;endArrow=none;strokeColor=#4C8550;" edge="1" parent="1" source="user" target="notebook"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="805" y="570"/><mxPoint x="530" y="570"/></Array></mxGeometry></mxCell>

        <mxCell id="composition" value="Composition" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeWidth=2;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;startArrow=diamond;startFill=1;endArrow=none;strokeColor=#4C8550;" edge="1" parent="1" source="notebook" target="note"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="association" value="Association — author" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;jettySize=auto;rounded=0;html=1;strokeWidth=2;fontSize=15;fontStyle=1;labelBackgroundColor=#FFFFFF;startArrow=none;endArrow=none;strokeColor=#35658A;" edge="1" parent="1" source="note" target="user"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1450" y="755"/><mxPoint x="1510" y="755"/><mxPoint x="1510" y="540"/><mxPoint x="1100" y="540"/><mxPoint x="1100" y="310"/></Array></mxGeometry></mxCell>

        <mxCell id="legend" value="&lt;b&gt;RELATIONSHIP KEY&lt;/b&gt;&lt;br/&gt;&lt;b&gt;Inheritance:&lt;/b&gt; Admin extends User (hollow triangle points to User).&lt;br/&gt;&lt;b&gt;Aggregation:&lt;/b&gt; User has NoteBooks that can exist independently (hollow diamond at User).&lt;br/&gt;&lt;b&gt;Composition:&lt;/b&gt; NoteBook contains Notes (filled diamond at NoteBook).&lt;br/&gt;&lt;b&gt;Association:&lt;/b&gt; Each Note references its author through userId (User)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#9AAABA;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=14;fontSize=14;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="70" y="900" width="1460" height="85" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
